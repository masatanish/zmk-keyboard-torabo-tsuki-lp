#include <behaviors.dtsi>
#include <behaviors/us_to_jis.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

#define JP_KANA         LANGUAGE_1        // かな
#define JP_EISU         LANGUAGE_2        // 英数
#define JP_HANZEN       GRAVE             // 半角/全角
#define JP_HEN          INT4              // 変換
#define JP_MUHEN        INT5              // 無変換

/ {

    combos {
        compatible = "zmk,combos";

        bt_clear {
            bindings = <&bt BT_CLR>;
            key-positions = <28 29>;
            layers = <1>;
        };
    };

    macros {
        bt_sel0_to0: bt_sel0_to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 0 &to 0 &u2j_off>;
        };

        bt_sel1_to0: bt_sel1_to0 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 1 &to 0 &u2j_off>;
        };

        bt_sel2_to2: bt_sel2_to2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 2 &to 1 &u2j_on>;
        };

        bt_sel3_to2: bt_sel3_to2 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&macro_tap &bt BT_SEL 3 &to 1 &u2j_on>;
        };
    };

    behaviors {
        ctrl_hen: ctrl_hen {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <180>;
            quick-tap-ms = <200>;
            bindings = <&kp>, <&kp>;
        };
    };

    keymap {
        compatible = "zmk,keymap";
        layer_0 {
            bindings = <
&none          &none      &none         &none     &none       &none                                   &none       &none  &none      &none    &none          &none
&kp TAB        &kp Q      &kp W         &kp E     &kp R       &kp T                                   &kp Y       &kp U  &kp I      &kp O    &kp P          &kp MINUS
&kp LCTRL      &kp A      &kp S         &kp D     &kp F       &kp G           &none        &none      &kp H       &kp J  &kp K      &kp L    &lt 4 SEMI     &lt 3 SQT
&mt LSHIFT ESC &kp Z      &kp X         &kp C     &kp V       &kp B           &kp END      &kp HOME   &kp N       &kp M  &kp COMMA  &kp DOT  &kp SLASH      &kp BACKSLASH
&kp ESCAPE     &kp LCTRL  &kp LA(SPACE) &kp LALT  &lt 2 LANG2 &mt LGUI LANG1  &lt 4 SPACE  &kp ENTER  &lt 3 BSPC  &none  &none      &mo 4    &kp LA(LG(N1)) &kp LA(LG(N2))
            >;
        };

        layer_1 {
            bindings = <
&trans       &trans      &trans   &trans   &trans         &trans                                        &trans     &trans  &trans  &trans  &trans     &trans
&trans       &trans      &trans   &trans   &trans         &trans                                        &trans     &trans  &trans  &trans  &trans     &trans
&trans       &trans      &trans   &trans   &trans         &trans                 &none        &none     &trans     &trans  &trans  &trans  &trans     &trans
&trans       &trans      &trans   &trans   &trans         &trans                 &trans       &trans    &trans     &trans  &trans  &trans  &trans     &trans
&kp ESCAPE   &kp LCTRL   &kp LGUI &kp LALT &lt 2 JP_MUHEN &ctrl_hen LCTRL JP_HEN &lt 4 SPACE  &kp ENTER &lt 3 BSPC &none   &none   &mo 4   &kp LG(N1) &kp LG(TAB)
            >;
        };

        layer_2 {
            bindings = <
&trans  &trans    &trans       &trans    &trans      &trans                                  &trans         &trans         &trans     &trans    &trans        &trans
&trans  &kp EXCL  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                             &kp CARET      &kp AMPS       &kp ASTRK  &kp LPAR  &kp RPAR      &kp UNDER
&trans  &kp N1    &kp N2       &kp N3    &kp N4      &kp N5      &none          &none        &kp GRAVE      &kp EQUAL      &kp LBKT   &kp RBKT  &kp COLON     &kp DQT
&trans  &kp N6    &kp N7       &kp N8    &kp N9      &kp N0      &kp PAGE_DOWN  &kp PAGE_UP  &kp MINUS      &kp BACKSLASH  &kp LT     &kp GT    &kp QUESTION  &kp PIPE
&trans  &trans    &trans       &trans    &trans      &trans      &trans         &trans       &kp BSPC       &none          &none      &trans    &trans        &trans
            >;
        };

        layer_3 {
            bindings = <
&trans  &trans  &trans     &trans     &trans     &trans                              &trans        &trans     &trans    &trans     &trans           &trans
&kp F1  &kp F2  &kp F3     &kp F4     &kp F5     &kp F6                              &kp F7        &kp F8     &kp F9    &kp F10    &kp F11          &kp F12
&trans  &trans  &trans     &trans     &trans     &trans  &trans         &trans       &kp LG(LBKT)  &mkp LCLK  &kp UP    &mkp RCLK  &trans           &trans
&trans  &trans  &kp LG(X)  &kp LG(C)  &trans     &trans  &kp PAGE_DOWN  &kp PAGE_UP  &kp LG(RBKT)  &kp LEFT   &kp DOWN  &kp RIGHT  &kp LA(LG(LEFT)) &kp LA(LG(RIGHT))
&trans  &trans  &trans     &trans     &trans     &trans  &kp SPACE      &trans       &kp BSPC      &trans     &trans    &trans     &kp LA(LG(N4))   &kp LA(LG(N3))
            >;
        };

        layer_4 {
            bindings = <
&trans &trans            &trans        &trans        &trans &trans                 &trans        &trans        &trans            &trans         &trans        &trans
&trans &trans            &trans        &trans        &trans &trans                 &bt_sel0_to0  &bt_sel1_to0  &bt_sel2_to2      &bt_sel3_to2   &bt BT_SEL 4  &trans
&trans &kp C_PLAY_PAUSE  &trans        &trans        &trans &trans  &trans  &trans &trans        &trans        &kp LC(UP_ARROW)  &trans         &trans        &trans
&trans &kp C_MUTE        &kp C_VOL_DN  &kp C_VOL_UP  &to 0  &to 1   &trans  &trans &trans        &kp LC(LEFT)  &kp LC(DOWN)      &kp LC(RIGHT)  &trans        &trans 
&trans &trans            &trans        &trans        &trans &trans  &trans  &mo 5  &kp DEL       &trans        &trans            &u2j_on        &u2j_off      &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans                         &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &bt BT_CLR &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &bt BT_CLR_ALL &trans  &trans     &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans         &trans  &trans     &trans  &trans  &trans  &trans
            >;
        };
    };
};
